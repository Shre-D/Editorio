# Editorio Environment Variables
# Copy this file to .env and update values for your environment

# PostgreSQL
POSTGRES_USER=editorio
POSTGRES_PASSWORD=editorio_secret
POSTGRES_DB=editorio

# RabbitMQ
RABBITMQ_USER=editorio
RABBITMQ_PASSWORD=editorio_secret

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# LiveKit (change these in production!)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Node Environment
NODE_ENV=development
